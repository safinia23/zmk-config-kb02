/*
 * kb02test keymap — split 検証（左 2×2 ＋ 右 2×2）
 *   左: (0,0)=A (0,1)=B / (1,0)=C (1,1)=D
 *   右: (0,2)=E (0,3)=F / (1,2)=左クリック (1,3)=右クリック
 */
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define HAS_MOUSE_TP
#include "include/mouse_tp.dtsi"

#ifdef HAS_MOUSE_TP
  #define U_LCLK &mkp LCLK
  #define U_RCLK &mkp RCLK
#else
  #define U_LCLK &kp G
  #define U_RCLK &kp H
#endif

/ {
    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "Base";
            bindings = <
                &kp A   &kp B      &kp E   &kp F
                &kp C   &kp D      U_LCLK  U_RCLK
            >;
        };
    };
};
