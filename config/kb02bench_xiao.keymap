/*
 * kb02bench_xiao keymap — 2×2 仮マトリクス
 *   (0,0)=A  (0,1)=B
 *   (1,0)=左クリック  (1,1)=右クリック
 */
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

// TP なしでビルドしたいときはこの define をコメントアウト
#define HAS_MOUSE_TP
#include "include/mouse_tp.dtsi"

#ifdef HAS_MOUSE_TP
  #define U_LCLK &mkp LCLK
  #define U_RCLK &mkp RCLK
#else
  #define U_LCLK &kp C
  #define U_RCLK &kp D
#endif

/ {
    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "Base";
            bindings = <
                &kp A   &kp B
                U_LCLK  U_RCLK
            >;
        };
    };
};
